{
  "name": "workstream",
  "version": "0.2.46",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/build-main.mjs",
    "start": "electron .",
    "test": "vitest run",
    "lint": "eslint .",
    "package": "npm run build && electron-builder --win portable",
    "test:desktop": "node scripts/smoke.mjs",
    "test:live": "node scripts/live-smoke.mjs",
    "copilot-runtime": "node scripts/fetch-copilot-runtime.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-slot": "1.5.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cn": "0.4.0",
    "lucide-react": "1.57.0",
    "radix-ui": "1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.288",
    "@eslint/js": "9.39.5",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/express": "5.0.6",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.7.2",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "express": "5.3.0",
    "globals": "17.13.0",
    "playwright": "1.64.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.4",
    "@github/copilot-sdk": "1.0.22"
  },
  "build": {
    "appId": "local.workstream.desktop",
    "productName": "Workstream",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "skills/**",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "icon": "build/icon.ico",
      "signExecutable": false
    },
    "extraResources": [
      {
        "from": "build/copilot-runtime",
        "to": "copilot-runtime",
        "filter": [
          "**/*"
        ]
      }
    ]
  },
  "description": "A local task-to-pull-request workspace with independent development and review agents.",
  "author": "Workstream"
}
